# Doit avoir deux niveaux (ex. dev.localhost) pour le login unique
DOMAIN=dev.localhost
SUBDOMAIN=local
ORACLE_PASSWORD=password
ORACLE_USER=user
ORACLE_USER_PASSWORD=password

# MariaDB Settings
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=db_master
MARIADB_USER=admin
MARIADB_PASSWORD=password

# Login unique (tinyauth) pour les outils web. Générer la valeur avec :
#   docker run --rm httpd:alpine htpasswd -nbB admin 'motdepasse'
# Garder les guillemets simples : ils empêchent Compose d'interpréter les $ du hash.
TINYAUTH_USERS='admin:$2y$05$remplacer.par.le.hash'

# WUD : fréquence de vérification des mises à jour d'images (cron 5 champs).
# Choisir un créneau où la VM WSL tourne.
WUD_CRON=0 12 * * *
# Même mot de passe que le login unique (tinyauth) : un seul couple admin / mot de passe partout
WUD_ADMIN_PASSWORD=

# Grafana
GRAFANA_ADMIN_PASSWORD=changeme

# Restic
# ATTENTION : sans ce mot de passe, les sauvegardes sont IRRÉCUPÉRABLES.
# Le conserver dans un gestionnaire de mots de passe.
RESTIC_PASSWORD=
# Dossier du dépôt de sauvegarde. Pour survivre à une perte du disque de la VM,
# pointer vers un autre disque, par ex. /mnt/c/Backups/docker-master
RESTIC_REPOSITORY_PATH=./mnt/restic/repo
RESTIC_CRON=30 12 * * *
RESTIC_CHECK_CRON=0 13 * * 1

# Hoppscotch (client API)
HOPPSCOTCH_DB_PASSWORD=changeme
# Exactement 32 caractères (ex. openssl rand -hex 16). Ne plus la changer ensuite :
# elle chiffre des données stockées en base.
HOPPSCOTCH_ENCRYPTION_KEY=

# Healthchecks (surveillance des tâches planifiées)
HEALTHCHECKS_SECRET_KEY=changeme
# Clé de ping du projet, écrite par `make healthchecks-init`
HEALTHCHECKS_PING_KEY=

# Dossier qui contient tous les projets Compose (pour Dockge). Chemin absolu.
PROJECTS_DIR=/home/user/projects

# Compte admin de Dockge, aligné sur le login unique (mot de passe changé avec
# `docker exec -it dockge npx tsx ./extra/reset-password.ts`)
DOCKGE_ADMIN_PASSWORD=

# Clients OIDC de tinyauth : connexion automatique de Portainer et WUD (HTTPS requis).
# Secrets aléatoires, par ex. openssl rand -hex 24. Pour Portainer, le même secret est
# saisi dans Settings > Authentication > OAuth (enregistré dans sa propre base).
TINYAUTH_OIDC_PORTAINER_SECRET=
TINYAUTH_OIDC_WUD_SECRET=
