DOMAIN=domain.com
SUBDOMAIN=local
ORACLE_PASSWORD=password
ORACLE_USER=user
ORACLE_USER_PASSWORD=password

# MariaDB Settings
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=db_master
MARIADB_USER=admin
MARIADB_PASSWORD=password

# Traefik dashboard (use a compatible htpasswd hash, for example: htpasswd -nsB admin)
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD_HASH=replace-with-bcrypt-hash

# Watchtower schedule: seconds minutes hours day-of-month month day-of-week
WATCHTOWER_SCHEDULE=0 0 4 * * *

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# Restic (keep RESTIC_PASSWORD safe: it is required to restore backups)
RESTIC_PASSWORD=replace-with-a-strong-password
RESTIC_REPOSITORY=/repository
RESTIC_INTERVAL=86400
