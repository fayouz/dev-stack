.env

# Données des services (seule la configuration de mnt/ est versionnée)
mnt/*/data/
mnt/oracle/
mnt/postgres/
mnt/restic/repo/
mnt/restic/dumps/
mnt/restic/status/
mnt/restic/requests/
mnt/trivy/cache/
mnt/trivy/status/
mnt/trivy/requests/
mnt/wud/store/
# Liens vers les projets locaux, propres à chaque machine (make dockge-sync)
mnt/dockge/stacks/
# Session Hoppscotch et empreintes de synchro
mnt/hoppscotch-sync/state/
# Autorité locale et certificat HTTPS (clés privées, propres à chaque machine)
mnt/certs/
mnt/organizr/config/
node_modules/

# Sauvegarde du compose créée par WUD avant chaque mise à jour
*.back

# Fichiers personnels d'IDE et d'agents IA
.ai/
.junie/
.idea/deployment.xml
.idea/dictionaries/
.idea/jsonSchemas.xml
