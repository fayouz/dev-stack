.env

# Données des services (seule la configuration de mnt/ est versionnée)
mnt/*/data/
mnt/oracle/
mnt/postgres/
mnt/restic/repo/
mnt/restic/dumps/
mnt/restic/status/
mnt/wud/store/
# Liens vers les projets locaux, propres à chaque machine (make dockge-sync)
mnt/dockge/stacks/
# Session Hoppscotch et empreintes de synchro
mnt/hoppscotch-sync/state/
mnt/organizr/config/
node_modules/

# Sauvegarde du compose créée par WUD avant chaque mise à jour
*.back
